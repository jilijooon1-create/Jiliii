<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="20dp"
    android:background="@color/jili_bg">

    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Jili"
        android:textColor="@color/jili_text" android:textSize="32sp"
        android:textStyle="bold" android:gravity="center"/>

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="آماده‌ام"
        android:textColor="@color/jili_muted" android:textSize="15sp"
        android:gravity="center" android:paddingTop="6dp" android:paddingBottom="18dp"/>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView android:id="@+id/conversation"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="@color/jili_text" android:textSize="17sp"
                android:padding="14dp" android:text="سلام 👋 من Jili هستم.
یک فرمان بده یا از دکمه‌های پایین استفاده کن." />

            <Button android:id="@+id/btnPermission"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="🔐 مدیریت دسترسی‌ها" android:layout_marginTop="12dp"/>

            <Button android:id="@+id/btnSync"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="☁️ وضعیت Sync" android:layout_marginTop="8dp"/>

            <Button android:id="@+id/btnSettings"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="⚙️ تنظیمات Jili" android:layout_marginTop="8dp"/>
        </LinearLayout>
    </ScrollView>

    <EditText android:id="@+id/input"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:hint="فرمان را بنویس..."
        android:textColor="@color/jili_text" android:hintTextColor="@color/jili_muted"
        android:singleLine="true"/>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal">
        <Button android:id="@+id/btnVoice" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:text="🎙️ صحبت"/>
        <Button android:id="@+id/btnSend" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:text="ارسال ➜"/>
    </LinearLayout>
</LinearLayout>
